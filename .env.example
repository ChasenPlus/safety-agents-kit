# 复制为 .env 后填写（本文件本身不含任何真实密钥）
# 只填你实际使用的那一家即可

# OpenAI 兼容（DeepSeek / Qwen / Kimi / 智谱 / vLLM / Ollama 都走这一套）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# 覆盖配置项（可选）
# SAK_PROVIDER=openai
# SAK_MODEL=deepseek-chat
# SAK_BASE_URL=https://api.deepseek.com/v1
# SAK_API_KEY=sk-xxx
# SAK_KB_ROOT=./kb
